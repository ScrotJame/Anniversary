# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.agents/
docs

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal photos: kept on this machine only, never committed (repo is public)
/public/content/**/*.jpg
/public/content/**/*.jpeg
/public/content/**/*.png
/public/content/**/*.webp
/public/content/**/*.heic
/public/content/**/*.gif
/public/content/**/*.avif

# local clone of the private photo repo (ScrotJame/Anniversary-content)
/content-private/
